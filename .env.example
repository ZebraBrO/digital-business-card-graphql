# Настройки подключения к PostgreSQL (для локального запуска и Docker)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=digital_card_db
POSTGRES_PORT=5432

# Строка подключения Prisma ORM к PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/digital_card_db?schema=public"

# Настройки сервера NestJS
PORT=3000
NODE_ENV=development
